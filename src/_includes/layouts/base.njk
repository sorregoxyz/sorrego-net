<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "Santiago Orrego — Experimental Ethnography" }}</title>
  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
</head>
<body class="page--{{ page_type or 'default' }}"{% if theme_color %} style="background: {{ theme_color }};"{% endif %}>

  <div class="shell">

    <div class="header-grid">

      <aside class="sidebar__header">
        <a class="wordmark" href="{{ '/' | url }}">{% block wordmark %}home{% endblock %}</a>
        <span class="accent-dash"></span>
        {% block nav %}
        <nav class="nav-list">
          <a href="{{ '/tid/' | url }}">things I've done</a>
          <a href="{{ '/cabinet/' | url }}">cabinet of definitions</a>
          <a href="{{ '/blog/' | url }}">blog</a>
        </nav>
        {% endblock %}
      </aside>

      <div class="main__header">
        <div class="main-header-row">
          {% block site_title %}
          <div class="site-title">Santiago Orrego – Experimental Ethnography</div>
          {% endblock %}
          <nav class="main-links">
            <a href="{{ '/cv/' | url }}">CV</a>
            <a href="mailto:santiago@sorrego.net">Mail</a>
            <a href="https://github.com/sorregoxyz" target="_blank" rel="noopener">GitHub</a>
          </nav>
        </div>

        <div class="main__subheader">
          <div>
            {% block subheader %}{% endblock %}
          </div>

          {% if not hide_default_search %}
          {% include "partials/search-bar.njk" %}
          {% endif %}
        </div>
      </div>

    </div>

    <hr class="header-rule">

    <main class="page-content">
      {% block content %}{% endblock %}
    </main>

  </div>

  <footer class="site-footer">
    <span>
      <a href="{{ '/' | url }}">Santiago Orrego</a> |
      <span id="footer-year"></span> |
      Content licensed under <a href="https://creativecommons.org/licenses/by/4.0/deed.en" target="_blank" rel="noopener">CC BY 4.0</a>
    </span>
    <span>Experimenting online from 2020</span>
  </footer>

  <script>
    document.getElementById('footer-year').textContent = new Date().getUTCFullYear();
  </script>

</body>
</html>
