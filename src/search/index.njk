---
permalink: /search/
title: "Search — Santiago Orrego"
page_type: tid
is_entry_page: true
eleventyExcludeFromCollections: true
---
{% extends "layouts/base.njk" %}

{% block nav %}{% include "partials/tid-nav.njk" %}{% endblock %}

{% block content %}
<div class="tid-section" data-pagefind-ignore>
  <h1 class="section-title">
    <span class="section-title__current">search</span>
  </h1>
  <div class="rule-double"></div>

  <p id="search-status" class="section-subtitle">Type something in the search box above and press enter.</p>
  <ul id="search-results" class="tid-section__pieces"></ul>
</div>

<script type="module">
  const params = new URLSearchParams(window.location.search);
  const query = params.get("q") || "";
  const statusEl = document.getElementById("search-status");
  const resultsEl = document.getElementById("search-results");
  const pathPrefix = "{{ '/' | url }}".replace(/\/$/, "");
  const pagefindURL = "{{ '/pagefind/pagefind.js' | url }}";

  function resolveUrl(rootRelativeUrl) {
    return (pathPrefix + rootRelativeUrl).replace(/\/{2,}/g, "/");
  }

  if (query) {
    statusEl.textContent = "Searching for “" + query + "”…";

    import(pagefindURL)
      .then(async (pagefind) => {
        await pagefind.init();
        const search = await pagefind.search(query);

        if (!search.results.length) {
          statusEl.textContent = "No results found for “" + query + "”.";
          return;
        }

        const items = await Promise.all(search.results.map((r) => r.data()));
        statusEl.textContent =
          items.length + " result" + (items.length === 1 ? "" : "s") +
          " for “" + query + "”:";

        resultsEl.innerHTML = items
          .map(
            (item) =>
              `<li><a href="${resolveUrl(item.url)}">${item.meta.title || item.url}</a></li>`
          )
          .join("");
      })
      .catch(() => {
        statusEl.textContent =
          "Search isn't available in this preview — it only works on the deployed site, after a full build.";
      });
  }
</script>
{% endblock %}
