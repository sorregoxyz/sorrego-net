{
  "name": "sorrego-net",
  "version": "0.1.0",
  "description": "sorrego.net — static rebuild (Eleventy)",
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "postbuild": "pagefind --site _site",
    "build:gh-pages": "eleventy --pathprefix=sorrego-net",
    "postbuild:gh-pages": "pagefind --site _site"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0",
    "pagefind": "^1.1.0"
  }
}
